# Copy to .env and fill values. .env is gitignored; never commit real keys.
# The local web app reads this file automatically. Shell/CI variables win.

# Provider: deepseek | openai | anthropic | openai-compatible | anthropic-compatible | ollama
NOVEL_LLM_PROVIDER=deepseek
NOVEL_LLM_MODEL=deepseek-chat

# Paste your own key after the equals sign, or use the web page's AI Settings.
# Never commit a real key.
NOVEL_LLM_API_KEY=

# Optional overrides
# NOVEL_LLM_BASE_URL=https://api.deepseek.com
# NOVEL_LLM_API_KEY_ENV=DEEPSEEK_API_KEY
# NOVEL_LLM_TEMPERATURE=0.8
# NOVEL_LLM_MAX_TOKENS=4096
# NOVEL_LLM_TIMEOUT=120

# Example: OpenAI
# NOVEL_LLM_PROVIDER=openai
# NOVEL_LLM_MODEL=gpt-4o-mini
# NOVEL_LLM_API_KEY=

# Example: Anthropic
# NOVEL_LLM_PROVIDER=anthropic
# NOVEL_LLM_MODEL=claude-sonnet-5
# NOVEL_LLM_API_KEY=

# Example: any OpenAI-compatible endpoint (base URL is required)
# NOVEL_LLM_PROVIDER=openai-compatible
# NOVEL_LLM_BASE_URL=https://your-endpoint.example/v1
# NOVEL_LLM_MODEL=your-model
# NOVEL_LLM_API_KEY=

# Local web server (all optional; command-line flags take precedence)
# NOVEL_SERVER_HOST=127.0.0.1
# NOVEL_SERVER_PORT=8000
# NOVEL_DATA_PATH=data/novel.db
# Quality mode: rules | rules+llm | rules+score | full
# NOVEL_QUALITY_MODE=full

# Example: use DeepSeek's Anthropic-compatible endpoint.
# This machine's Claude Code config points here; the token is a DeepSeek key.
# NOVEL_LLM_PROVIDER=anthropic-compatible
# NOVEL_LLM_BASE_URL=https://api.deepseek.com/anthropic
# NOVEL_LLM_MODEL=deepseek-v4-flash
# NOVEL_LLM_API_KEY_ENV=ANTHROPIC_AUTH_TOKEN
