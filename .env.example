# Copy to .env and fill values. .env is gitignored; never commit real keys.

# Provider: deepseek | openai | anthropic | openai-compatible | anthropic-compatible | ollama
NOVEL_LLM_PROVIDER=deepseek
NOVEL_LLM_MODEL=deepseek-chat

# Optional overrides
# NOVEL_LLM_BASE_URL=https://api.deepseek.com
# NOVEL_LLM_API_KEY_ENV=DEEPSEEK_API_KEY
# NOVEL_LLM_API_KEY=
# NOVEL_LLM_TEMPERATURE=0.8
# NOVEL_LLM_MAX_TOKENS=4096
# NOVEL_LLM_TIMEOUT=120

# Example: use DeepSeek's Anthropic-compatible endpoint.
# This machine's Claude Code config points here; the token is a DeepSeek key.
# NOVEL_LLM_PROVIDER=anthropic-compatible
# NOVEL_LLM_BASE_URL=https://api.deepseek.com/anthropic
# NOVEL_LLM_MODEL=deepseek-v4-flash
# NOVEL_LLM_API_KEY_ENV=ANTHROPIC_AUTH_TOKEN
