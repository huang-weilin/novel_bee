page {
  background: #f3eee4;
  color: #211d18;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Serif SC", "Songti SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  padding: 24rpx 24rpx 80rpx;
}

.hero {
  padding: 16rpx 8rpx 24rpx;
}

.hero-title {
  font-size: 44rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
}

.hero-sub {
  margin-top: 8rpx;
  color: #6b6154;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.card {
  background: #fbf8f1;
  border: 1rpx solid #d8cebd;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(52, 41, 26, 0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #211d18;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.between {
  justify-content: space-between;
}

.wrap {
  flex-wrap: wrap;
}

.flex {
  flex: 1;
  min-width: 0;
}

.hint {
  color: #6b6154;
  font-size: 24rpx;
  line-height: 1.7;
}

.error-text {
  color: #9e2f2f;
  font-size: 25rpx;
  line-height: 1.7;
  word-break: break-all;
}

.divider {
  height: 1rpx;
  background: #e2d8c7;
  margin: 20rpx 0;
}

.empty {
  padding: 40rpx 16rpx;
  text-align: center;
  color: #8c8172;
  font-size: 25rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d8cebd;
  border-radius: 16rpx;
  background: #fbf8f1;
  color: #211d18;
  padding: 0 28rpx;
  height: 76rpx;
  font-size: 28rpx;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #9b3d2e;
  border-color: #9b3d2e;
  color: #fff8ee;
  letter-spacing: 2rpx;
}

.btn-ghost {
  background: transparent;
}

.btn-small {
  height: 60rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
}

.btn-block {
  width: 100%;
  margin-top: 16rpx;
}

.btn[disabled] {
  opacity: 0.5;
}

.field {
  margin-bottom: 22rpx;
}

.field-label {
  display: block;
  color: #6b6154;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.field-required {
  color: #9b3d2e;
  margin-left: 4rpx;
}

.input,
.textarea,
.picker {
  width: 100%;
  box-sizing: border-box;
  background: #fffdf8;
  border: 1rpx solid #d8cebd;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #211d18;
  min-height: 44rpx;
}

.textarea {
  min-height: 180rpx;
  line-height: 1.7;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mini-input {
  background: #fffdf8;
  border: 1rpx solid #d8cebd;
  border-radius: 10rpx;
  padding: 10rpx 14rpx;
  font-size: 24rpx;
  min-height: 40rpx;
}

.pill {
  display: inline-block;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  border: 1rpx solid #d8cebd;
  color: #6b6154;
  white-space: nowrap;
}

.pill-final {
  color: #3f6b4f;
  background: #dce9df;
  border-color: #b8ceb9;
}

.pill-pending {
  color: #8a641f;
  background: #f3e6c7;
  border-color: #dfc78b;
}

.pill-failed {
  color: #9e2f2f;
  background: #f0dcd5;
  border-color: #e0b4ad;
}

.pill-muted {
  color: #6b6154;
  background: #f3eee4;
}

.list-item {
  padding: 22rpx 0;
  border-top: 1rpx solid #e2d8c7;
}

.list-item:first-child {
  border-top: none;
  padding-top: 4rpx;
}

.item-title {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.5;
}

.item-meta {
  color: #6b6154;
  font-size: 23rpx;
  margin-top: 6rpx;
}

.progress-track {
  height: 10rpx;
  border-radius: 999rpx;
  background: #e9e1d3;
  overflow: hidden;
  margin: 18rpx 0;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #9b3d2e, #c5764f);
  transition: width 0.3s ease;
}

.score {
  color: #9b3d2e;
  font-size: 40rpx;
  font-weight: 700;
}

.failure-list {
  margin-top: 16rpx;
}

.failure-item {
  border-left: 6rpx solid #d9a18f;
  background: #fff8f3;
  border-radius: 0 12rpx 12rpx 0;
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.failure-sev {
  color: #9e2f2f;
  font-weight: 700;
  margin-right: 8rpx;
}

.score-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.review-box {
  margin-top: 18rpx;
  border: 1rpx solid #dfc78b;
  background: #fbf3df;
  border-radius: 16rpx;
  padding: 20rpx;
}

.review-item {
  border-top: 1rpx dashed #dfc78b;
  padding: 16rpx 0;
}

.review-item:first-child {
  border-top: none;
  padding-top: 0;
}

.review-name {
  font-size: 26rpx;
  font-weight: 600;
}

.review-reason {
  color: #8a641f;
  font-size: 23rpx;
  margin-top: 4rpx;
}

.review-form {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.chapter-text {
  white-space: pre-wrap;
  word-break: break-word;
  font-family: "Noto Serif SC", "Songti SC", SimSun, serif;
  font-size: 31rpx;
  line-height: 2;
  color: #2b261f;
  margin-top: 20rpx;
}

.ai-note {
  margin-top: 18rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #e2d8c7;
  color: #8c8172;
  font-size: 22rpx;
  line-height: 1.6;
}

.stats {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.stat {
  background: #fffdf8;
  border: 1rpx solid #e2d8c7;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: #6b6154;
}

.stat-strong {
  color: #211d18;
  font-weight: 600;
}

.tip {
  background: #f0dcd5;
  color: #7d2f24;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  font-size: 23rpx;
  line-height: 1.7;
  margin-top: 14rpx;
}

.server-box {
  margin-top: 8rpx;
}

.scene-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.scene-grid .field {
  width: calc(50% - 7rpx);
  margin-bottom: 0;
}
